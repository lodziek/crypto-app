# Clé CoinGecko (plan Demo). Secret : jamais de préfixe NEXT_PUBLIC_.
# Sans elle l'app fonctionne, mais sur le quota public partagé par IP (429 fréquents).
COINGECKO_API_KEY=

# Base publique du site, sert aux métadonnées et aux images OG. Peut rester vide :
# le code retombe alors sur l'URL de production. Si elle est renseignée, ce doit
# être une origine complète (https://…), sinon le build échoue avec un message
# explicite plutôt que de publier des métadonnées fausses.
NEXT_PUBLIC_SITE_URL=
